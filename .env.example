# Local compose defaults for the unofficial Silo Server image.

PUID=1000
PGID=1000
TZ=Europe/Berlin

IMAGE_NAME=ghcr.io/mildman1848/silo-server
IMAGE_TAG=git-881c968-mldm1

# Prefer our own LSIO/s6-style dependency images where compatible.
POSTGRES_IMAGE=ghcr.io/mildman1848/postgresql:18.4-mldm4
CACHE_IMAGE=ghcr.io/mildman1848/valkey:9.0.4-mldm1

# Required: change this to your host media path.
MEDIA_ROOT=/srv/media

# Published ports.
PORT=8090
JF_PORT=8096
ABS_PORT=13378

# Database settings for the bundled compose example.
POSTGRES_USER=silo
POSTGRES_DB=silo
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Redis/Valkey is bundled in compose under the service name "redis" because Silo
# expects a Redis-protocol URL. Valkey is Redis-protocol compatible here.

# Required Silo master encryption key. Prefer FILE__SECRET_KEY via compose secrets.
SECRET_KEY_FILE=./secrets/silo_secret_key

# Silo runtime.
MODE=integrated
POSTGRES_TUNE=off
SILO_PUBLIC_URL=
SILO_TRUSTED_PROXIES=
